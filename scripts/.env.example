# Deployment Target: 'local' (self-hosted Docker) or 'cloud' (Supabase Cloud)
DEPLOYMENT_TYPE=

# Self-Hosted / Local: Path to your supabase-project directory
SUPABASE_PROJECT_DIR=

# Supabase Cloud: 20-character project reference ID (e.g. abcd1234efgh5678ijkl)
SUPABASE_PROJECT_REF=

# Database Connection Settings
DATABASE_URL=

# Core Application Settings
# Master key (32-character hex)
APP_MASTER_KEY=
MIN_CLIENT_VERSION=

# Slack Settings (Optional)
SLACK_BASE_URL=
SLACK_WEBHOOK_SECRET=
SLACK_NOTIFY_URL=

# Edge Function Secrets
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
X_WEBHOOK_SECRET=
LINEBUZZ_PAGE_URL=
